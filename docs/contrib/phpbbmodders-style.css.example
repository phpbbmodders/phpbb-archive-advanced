/* Colors approximate phpbbmodders.com's live prosilver_se_revolution
   theme: dark charcoal page (#2B2B2B) with a brick-red frame (#812B2B)
   around a white content well, brick-red (#862C23) header/category
   bars, and base-prosilver link/text colors underneath. Layout is the
   archive's own — only the color values were sourced from the site.

   Copied into every generated archive's assets/style.css by
   copy_assets() (see generate.py). To retouch the palette on an
   already-built archive without regenerating anything, edit this file
   and drop the resulting assets/style.css directly into that archive's
   output — every page already links to it. */
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Verdana, Geneva, sans-serif;
  font-size: 13px;
  color: #536482;
  background: #2B2B2B;
}
a { color: #105289; text-decoration: none; }
a:hover { text-decoration: underline; color: #D31141; }

h1, h2, h3 { color: #28313F; }
hr { border: 0; border-top: 1px solid #CCCCCC; }

/* ── layout ── */
#wrap { max-width: 1024px; margin: 0 auto; padding: 0 4px; background: #FFFFFF; border: 1px solid #812B2B; }

/* ── header ── */
#page-header {
  background: #2B2B2B;
  padding: 12px 16px;
  margin-bottom: 0;
}
#page-header h1 { margin: 0; font-size: 1.5em; color: #fff; }
#page-header h1 a { color: #fff; }
#page-header h1 a:hover { text-decoration: none; color: #D1E8FF; }
#page-header .site-desc { color: #A8C4E0; font-size: 0.9em; margin: 2px 0 0; }

/* ── breadcrumb ── */
.breadcrumb {
  font-size: 0.9em;
  margin-bottom: 8px;
  padding: 4px 8px;
  background: #EEEEEE;
  border: 1px solid #CCCCCC;
  color: #536482;
}
.breadcrumb a { color: #105289; }

/* ── forum index / category blocks ── */
.forabg, .forumbg {
  background: #862C23;
  border: 1px solid #6B231C;
  margin-bottom: 10px;
}
.forabg .header, .forumbg .header {
  padding: 6px 10px;
  font-weight: bold;
  color: #FFFFFF;
  background: #862C23;
  border-bottom: 1px solid #6B231C;
}
.forabg .header a { color: #FFFFFF; }
.forabg .header .header-title, .forumbg .header .header-title { display: block; }
.forabg .header .header-cols, .forumbg .header .header-cols {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  font-weight: normal;
  font-size: 0.85em;
  margin-top: 3px;
}
.forabg .header .header-cols .col-count, .forumbg .header .header-cols .col-count { min-width: 60px; text-align: right; }
.forabg .header .header-cols .col-lastpost, .forumbg .header .header-cols .col-lastpost { min-width: 180px; max-width: 180px; }
.forum-description { padding: 4px 10px 6px; font-size: 0.85em; color: #666666; background: #FFFFFF; border-bottom: 1px solid #CCCCCC; }
.forum-description--no-border { border-bottom: none; }
ul.topiclist { list-style: none; margin: 0; padding: 0; }
ul.topiclist.forums { background: #fff; }
ul.topiclist li.row {
  background: #E8ECEE;
  border-top: 1px solid #CCCCCC;
  padding: 6px 10px;
  display: flex;
  align-items: baseline;
  gap: 8px;
}
ul.topiclist li.row:hover { background: #EBEFF1; }
ul.topiclist li.row:first-child { border-top: none; }
ul.topiclist li.row .forum-title { font-weight: bold; flex: 1; }
ul.topiclist li.row .forum-title a { color: #105289; }
ul.topiclist li.row .forum-desc { font-size: 0.85em; color: #666666; font-weight: normal; }
ul.topiclist li.row .col-count { min-width: 60px; text-align: right; color: #666666; font-size: 0.9em; }
ul.topiclist li.row .col-lastpost { min-width: 180px; max-width: 180px; font-size: 0.85em; color: #666666; }

/* ── topic list (forum.html) ── */
table.topic-table { width: 100%; border-collapse: collapse; }
table.topic-table th {
  background: #862C23;
  color: #FFFFFF;
  padding: 5px 8px;
  text-align: left;
  border-bottom: 1px solid #6B231C;
}
table.topic-table td { padding: 5px 8px; border-top: 1px solid #CCCCCC; vertical-align: top; background: #fff; }
table.topic-table tr:first-child td { border-top: none; }
table.topic-table td.subject a { color: #105289; font-weight: bold; }
table.topic-table td.count { text-align: right; font-size: 0.9em; color: #666666; }
table.topic-table td.lastpost { font-size: 0.85em; color: #666666; }

/* ── post layout ── */
.post-wrap {
  display: flex;
  border: 1px solid #BFC1CF;
  margin-bottom: 8px;
  background: #fff;
}
.postprofile {
  min-width: 130px;
  max-width: 155px;
  width: 155px;
  padding: 8px;
  border-right: 1px solid #BFC1CF;
  background: #ECF1F3;
  color: #666666;
  font-size: 0.9em;
  flex-shrink: 0;
}
.postprofile strong { color: #000; display: block; margin-bottom: 4px; font-size: 1.05em; }
.postprofile a { color: #105289; }
.postprofile .user-avatar img { max-width: 90px; max-height: 90px; display: block; margin: 4px auto 6px; }
.postprofile .rank-img img { max-width: 120px; display: block; margin: 2px 0; }
.postbody { padding: 8px 12px; vertical-align: top; flex: 1; min-width: 0; }
.post-date { font-size: 0.85em; color: #666666; margin-bottom: 6px; border-bottom: 1px solid #CCCCCC; padding-bottom: 4px; }
.content { color: #333; max-width: 80ch; }
.sig {
  border-top: 1px solid #CCCCCC;
  margin-top: 10px;
  padding-top: 6px;
  font-size: 0.85em;
  color: #666666;
}

/* ── profile table ── */
table.tablebg { border-collapse: collapse; background: #fff; border: 1px solid #BFC1CF; }
table.tablebg th { background: #862C23; color: #FFFFFF; padding: 6px 10px; text-align: left; border-bottom: 1px solid #6B231C; }
table.tablebg td { padding: 5px 10px; border-top: 1px solid #CCCCCC; }

/* ── bbcode elements ── */
blockquote {
  background: #EBEADD;
  border-left: 4px solid #B5A481;
  margin: 8px 0 8px 16px;
  padding: 6px 10px;
  color: #333;
}
blockquote blockquote { background: #EFEED9; }
blockquote .quote-header { font-weight: bold; font-size: 0.9em; color: #666666; margin-bottom: 4px; }

.codebox {
  background: #FFFFFF;
  border: 1px solid #C9D2D8;
  margin: 8px 0;
  padding: 0;
}
.codebox pre {
  margin: 0;
  padding: 8px;
  overflow-x: auto;
  font-size: 0.9em;
  color: #333;
}

.inline-attachment { margin: 8px 0; }
.inline-attachment img { max-width: 100%; }
.attachment-missing { color: #BC2A4D; font-style: italic; }

/* Board-wide announcement (see --announcement). Real prosilver's own
   div.rules color — the live board's child theme doesn't override it. */
.announcement {
  background: #ECD5D8;
  border: 1px solid #D9AEB3;
  color: #BC2A4D;
  padding: 8px 12px;
  margin-bottom: 10px;
}

details.spoiler summary { cursor: pointer; color: #105289; }

/* ── footer ── */
#page-footer {
  text-align: center;
  font-size: 0.85em;
  color: #536482;
  margin-top: 10px;
  padding: 8px;
  border-top: 1px solid #CCCCCC;
  background: #EEEEEE;
}
#page-footer a { color: #105289; }
